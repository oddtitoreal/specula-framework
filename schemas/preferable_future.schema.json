{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specula.local/schemas/preferable_future.schema.json",
  "description": "Added in 1.3.",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "payload"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "phase",
        "mode",
        "generated_at",
        "validated_by_human",
        "related_artifacts",
        "decision_rationale",
        "evidence_refs",
        "tradeoffs",
        "rejected_alternatives"
      ],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "phase": { "const": "4" },
        "mode": { "const": "preferable_future" },
        "generated_at": { "type": "string", "format": "date-time" },
        "validated_by_human": { "const": false },
        "related_artifacts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "decision_rationale": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "tradeoffs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "rejected_alternatives": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preferable_future"],
      "properties": {
        "preferable_future": {
          "type": "object",
          "additionalProperties": false,
          "required": ["statement", "horizon", "rationale", "backcasting"],
          "properties": {
            "statement": { "type": "string", "minLength": 1 },
            "horizon": { "type": "string", "minLength": 1 },
            "rationale": { "type": "string", "minLength": 1 },
            "backcasting": {
              "type": "array",
              "minItems": 1,
              "description": "For each scenario, the steps from today toward the preferable future and whether they hold in that world.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["scenario_id", "steps"],
                "properties": {
                  "scenario_id": { "type": "string", "minLength": 1 },
                  "steps": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["step", "years_from_now", "holds"],
                      "properties": {
                        "step": { "type": "string", "minLength": 1 },
                        "years_from_now": { "type": "number", "minimum": 0 },
                        "holds": { "type": "boolean" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
