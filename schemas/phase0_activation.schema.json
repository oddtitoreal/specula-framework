{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specula.local/schemas/phase0_activation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "payload"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "phase",
        "mode",
        "generated_at",
        "validated_by_human",
        "related_artifacts",
        "decision_rationale",
        "evidence_refs",
        "tradeoffs",
        "rejected_alternatives"
      ],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "phase": { "const": "0" },
        "mode": { "const": "sensemaking" },
        "generated_at": { "type": "string", "format": "date-time" },
        "validated_by_human": { "const": false },
        "related_artifacts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "decision_rationale": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "tradeoffs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "rejected_alternatives": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activation_status",
        "current_phase",
        "context_set",
        "next_required_input"
      ],
      "properties": {
        "activation_status": { "const": "active" },
        "current_phase": {
          "type": "number",
          "enum": [0, 1, 1.5, 2, 3, 4, 5, 6]
        },
        "context_set": { "type": "boolean" },
        "next_required_input": { "type": "string", "minLength": 1 },
        "framing": {
          "type": "object",
          "additionalProperties": false,
          "description": "Added in 1.3 (optional). Threshold & Framing outputs of specula-method 2.0.",
          "properties": {
            "research_question": { "type": "string", "minLength": 1 },
            "time_window": { "type": "string", "minLength": 1 },
            "working_rules": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "consensus": {
              "type": "object",
              "additionalProperties": false,
              "required": ["signed_by", "date"],
              "properties": {
                "signed_by": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                },
                "date": { "type": "string", "format": "date" }
              }
            },
            "threshold_evidence": {
              "type": "object",
              "additionalProperties": false,
              "required": ["recognized_crisis", "real_mandate", "willingness_to_subtract"],
              "properties": {
                "recognized_crisis": { "type": "string", "minLength": 1 },
                "real_mandate": { "type": "string", "minLength": 1 },
                "willingness_to_subtract": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
