{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specula.local/schemas/decision_log.schema.json",
  "description": "Added in 1.3.",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "payload"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "phase",
        "mode",
        "generated_at",
        "validated_by_human",
        "related_artifacts",
        "decision_rationale",
        "evidence_refs",
        "tradeoffs",
        "rejected_alternatives"
      ],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "phase": { "type": "string", "enum": ["4", "5", "6"] },
        "mode": { "const": "decision_log" },
        "generated_at": { "type": "string", "format": "date-time" },
        "validated_by_human": { "const": false },
        "related_artifacts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "decision_rationale": { "type": "string", "minLength": 1 },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "tradeoffs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "rejected_alternatives": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisions"],
      "properties": {
        "decisions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["decision_id", "date", "decision", "criterion", "expected_effect", "review_date", "status"],
            "properties": {
              "decision_id": { "type": "string", "minLength": 1 },
              "date": { "type": "string", "format": "date" },
              "decision": { "type": "string", "minLength": 1 },
              "criterion": {
                "type": "string",
                "minLength": 1,
                "description": "Strategic Protocol criterion applied. Criteria are hypotheses; values stay fixed."
              },
              "expected_effect": { "type": "string", "minLength": 1 },
              "review_date": { "type": "string", "format": "date" },
              "observed_effect": { "type": ["string", "null"] },
              "status": { "type": "string", "enum": ["open", "reviewed"] },
              "minority_positions": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
